<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de capítulo igual que ChapterItem de la app oficial: check de leído a la
     izquierda, nombre (2 líneas) y fecha, y estado de descarga a la derecha. Encima,
     la línea discontinua "Descarga parcial N +" (ChapterStroke) cuando corresponde. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/chapter_card"
        android:backgroundTint="?attr/primaryBlackBackground"
        android:layout_marginBottom="5dp"
        android:layout_width="match_parent"
        app:cardCornerRadius="0dp"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:layout_height="wrap_content">

    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <!-- ChapterStroke de la app oficial: líneas discontinuas con el texto -->
        <LinearLayout
                android:id="@+id/chapter_stroke"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

            <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="3dp"
                    android:background="@drawable/chapter_stroke_line"
                    android:layout_marginEnd="12dp" />

            <TextView
                    android:id="@+id/chapter_stroke_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    tools:text="Partial download 10 +" />

            <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="3dp"
                    android:background="@drawable/chapter_stroke_line"
                    android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <!-- Capítulo leído (check_24px de la app oficial) -->
            <ImageView
                    android:id="@+id/chapter_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/has_read"
                    android:src="@drawable/check_24px"
                    app:tint="?attr/textColor"
                    android:visibility="gone"
                    tools:visibility="visible" />

            <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginHorizontal="5dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                <TextView
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:textSize="16sp"
                        tools:textColor="?attr/textColor"
                        android:layout_gravity="center_vertical"
                        tools:text="Chapter 1"
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                <!-- la oficial pinta la fecha con contentColor al 70% -->
                <TextView
                        tools:textSize="14sp"
                        tools:textColor="?attr/textColor"
                        android:alpha="0.7"
                        android:layout_gravity="center_vertical"
                        tools:text="Released 10h ago"
                        android:id="@+id/release_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                </TextView>
            </LinearLayout>

            <!-- Descargando ese capítulo (spinner de la app oficial) -->
            <ProgressBar
                    android:id="@+id/chapter_downloading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="4dp"
                    android:indeterminateTint="?attr/textColor"
                    android:visibility="gone"
                    tools:visibility="visible" />

            <!-- Estado de descarga: not_started / check_circle / arrow_circle_down_24px -->
            <ImageView
                    android:id="@+id/chapter_download_state"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="4dp"
                    android:contentDescription="@string/download"
                    android:src="@drawable/arrow_circle_down_24px"
                    app:tint="?attr/textColor"
                    android:visibility="gone"
                    tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
