<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/library_list_drag_handle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:src="@drawable/ic_baseline_menu_24"
        app:tint="?attr/grayTextColor"
        android:contentDescription="@string/library_list_reorder" />

    <TextView
        android:id="@+id/library_list_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:textSize="16sp"
        android:textColor="?attr/textColor"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Leyendo" />

    <ImageView
        android:id="@+id/library_list_edit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_baseline_edit_24"
        app:tint="?attr/textColor"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/library_list_rename" />

    <ImageView
        android:id="@+id/library_list_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_baseline_delete_outline_24"
        app:tint="?attr/textColor"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/library_list_delete" />
</LinearLayout>
