<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reader_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readerBackground"
    android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
    android:paddingTop="0dp">

    <FrameLayout
        android:id="@+id/read_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/read_loading_bar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:progressTint="@color/colorPrimary" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            tools:text="@string/delete" />

        <!-- Solo visible mientras se está traduciendo de verdad: detiene la traducción -->
        <ImageButton
            android:id="@+id/read_loading_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stop_translation"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/close_24px"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/read_fail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/fail_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            tools:text="@string/delete" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/read_normal_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        tools:alpha="1"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/reader_lin_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical">

            <View
                android:id="@+id/read_topmargin"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:id="@+id/read_top_item"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/real_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                tools:listitem="@layout/single_text" />

            <View
                android:id="@+id/read_bottom_item"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <ScrollView
                android:id="@+id/read_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:id="@+id/line_top_extra"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/colorPrimaryGreen"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/read_text_background"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/read_title_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:fontFamily="serif"
                            android:gravity="center_vertical"
                            android:paddingLeft="20dp"
                            android:paddingTop="20dp"
                            android:paddingRight="20dp"
                            android:paddingBottom="20dp"
                            android:textColor="@color/readerTextColor"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="TEST CHAPTER" />

                        <com.lagradost.quicknovel.ui.roundedbg.RoundedBgTextView
                            android:id="@+id/read_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="serif"
                            android:lineSpacingExtra="3sp"
                            android:paddingLeft="20dp"
                            android:paddingTop="25dp"
                            android:paddingRight="20dp"
                            android:paddingBottom="25dp"
                            android:textColor="@color/readerTextColor"
                            tools:text="@string/exampleTXT" />

                    </LinearLayout>
                </FrameLayout>

            </ScrollView>
        </LinearLayout>

        <View
            android:id="@+id/read_temp_bottom_margin"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:background="@color/colorPrimary"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/read_overlay"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_gravity="bottom"
            android:background="@color/transparent"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="visible">

            <TextClock
                android:id="@+id/read_time_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical"
                android:textColor="@color/readerTextColor"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="SmallSp"
                tools:text="20:35" />

            <TextView
                android:id="@+id/read_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:gravity="center_vertical"
                android:textColor="@color/readerTextColor"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="SmallSp"
                tools:text="20:35" />

            <TextView
                android:id="@+id/read_battery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical|end"
                android:textColor="@color/readerTextColor"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="SmallSp"
                tools:text="20:35" />

            <TextView
                android:id="@+id/read_chapter_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:textColor="@color/readerTextColor"
                android:textSize="10sp"
                android:visibility="gone"
                tools:ignore="SmallSp"
                tools:text="Chapter 1148 - You Will Support Me in the Future" />
        </FrameLayout>

        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/read_overflow_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="-5dp"
            android:visibility="gone" />


        <LinearLayout
            android:id="@+id/reader_bottom_view_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:visibility="gone"
            tools:ignore="UselessParent"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tts_stop_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                tools:text="TTS will stop in 5 min" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/reader_bottom_navigation_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/read_action_prev_chapter"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:background="@drawable/nav_button_circle"
                    android:contentDescription="@string/read_action_prev_chapter"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/pill_holder"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_chevron_left_24"
                    app:tint="?attr/white" />

                <FrameLayout
                    android:id="@+id/pill_holder"
                    android:layout_width="wrap_content"
                    android:layout_height="57dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/read_action_next_chapter"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/read_action_prev_chapter"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:id="@+id/reader_bottom_view"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/nav_pill_bg"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:visibility="visible">

                        <ImageButton
                            android:id="@+id/read_action_rotate"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_screen_rotation"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_baseline_screen_rotation_24"
                            app:tint="?attr/white" />

                        <ImageButton
                            android:id="@+id/read_action_tts"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_tts"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_baseline_volume_up_24"
                            app:tint="?attr/white" />

                        <ImageButton
                            android:id="@+id/read_action_chapters"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_chapters"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_baseline_list_24"
                            app:tint="?attr/white" />

                        <ImageButton
                            android:id="@+id/read_action_settings"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_settings"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_outline_settings_24"
                            app:tint="?attr/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/reader_bottom_view_tts"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/nav_pill_bg"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <ImageButton
                            android:id="@+id/tts_action_back"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_screen_rotation"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_baseline_fast_rewind_24"
                            app:tint="?attr/white" />

                        <ImageButton
                            android:id="@+id/tts_action_stop"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_tts"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_baseline_stop_24"
                            app:tint="?attr/white" />

                        <ImageButton
                            android:id="@+id/tts_action_pause_play"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_chapters"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_baseline_pause_24"
                            app:tint="?attr/white" />

                        <ImageButton
                            android:id="@+id/tts_action_forward"
                            android:layout_width="57dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/ripple_regular"
                            android:contentDescription="@string/read_action_settings"
                            android:padding="13dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_baseline_fast_forward_24"
                            app:tint="?attr/white" />
                    </LinearLayout>
                </FrameLayout>

                <ImageButton
                    android:id="@+id/read_action_next_chapter"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:background="@drawable/nav_button_circle"
                    android:contentDescription="@string/read_action_next_chapter"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/pill_holder"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_chevron_right_24"
                    app:tint="?attr/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>


        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/read_toolbar_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/primaryGrayBackground"
            android:minHeight="?attr/actionBarSize"
            tools:visibility="visible">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/read_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                app:navigationIconTint="?attr/iconColor"
                app:subtitleTextColor="?attr/grayTextColor"
                app:titleTextColor="?attr/textColor"
                tools:subtitle="TEST"
                tools:title="TEST" />
        </com.google.android.material.appbar.AppBarLayout>
    </FrameLayout>

    <!-- Menú lateral de términos sin traducir: se abre deslizando de izquierda a derecha -->
    <FrameLayout
        android:id="@+id/untranslated_drawer_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <View
            android:id="@+id/untranslated_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/untranslatedScrim" />

        <LinearLayout
            android:id="@+id/untranslated_drawer"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?attr/primaryGrayBackground"
            android:clickable="true"
            android:elevation="16dp"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/untranslated_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/untranslated_title"
                        android:textColor="?attr/textColor"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/untranslated_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/grayTextColor"
                        android:textSize="12sp"
                        tools:text="Capítulo 12 - The Spirit Stones" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/untranslated_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/untranslated_close"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/close_24px"
                    app:tint="?attr/textColor" />
            </LinearLayout>

            <TextView
                android:id="@+id/untranslated_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="?attr/grayTextColor"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="@string/untranslated_none"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/untranslated_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                tools:listitem="@layout/item_untranslated_term" />

            <!-- búsqueda para navegar por el capítulo (no guarda sustituciones) -->
            <LinearLayout
                android:id="@+id/untranslated_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/primaryBlackBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <EditText
                    android:id="@+id/untranslated_search_input"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_background"
                    android:hint="@string/untranslated_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="?attr/textColor"
                    android:textColorHint="?attr/grayTextColor"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/untranslated_search_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/untranslated_search_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/untranslated_search_prev"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_arrow_upward_24"
                    app:tint="?attr/textColor" />

                <ImageButton
                    android:id="@+id/untranslated_search_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/untranslated_search_next"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_arrow_downward_24"
                    app:tint="?attr/textColor" />
            </LinearLayout>

            <TextView
                android:id="@+id/untranslated_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/primaryBlackBackground"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/untranslated_note"
                android:textColor="?attr/grayTextColor"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- píldora flotante para seguir navegando entre coincidencias con el panel cerrado -->
    <LinearLayout
        android:id="@+id/untranslated_search_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/search_background"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/untranslated_search_pill_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:textColor="?attr/textColor"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/untranslated_search_pill_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/untranslated_search_prev"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_arrow_upward_24"
            app:tint="?attr/textColor" />

        <ImageButton
            android:id="@+id/untranslated_search_pill_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/untranslated_search_next"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_arrow_downward_24"
            app:tint="?attr/textColor" />

        <ImageButton
            android:id="@+id/untranslated_search_pill_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/untranslated_search_close"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/close_24px"
            app:tint="?attr/textColor" />
    </LinearLayout>
</FrameLayout>