<?xml version="1.0" encoding="utf-8"?>
<!-- Reproductor TTS (tarjeta flotante). Se incluye en la actividad principal y en la biblioteca;
     la logica comun esta en TTSMiniPlayerBinder. Ancho, margenes, posicion y visibilidad los pone
     cada <include>. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardBackgroundColor="?attr/primaryGrayBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:contentDescription="@string/tts_mini_player_open_reader">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/tts_mini_player_sheen"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

        <!-- Portada; mientras no esté cargada se ve el icono de relleno -->
        <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="?attr/boxItemBackground"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

            <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_baseline_collections_bookmark_24"
                    app:tint="?attr/grayTextColor" />

            <ImageView
                    android:id="@+id/ttsMiniPlayerCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/ttsMiniPlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/textColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Dios marcial Asura" />

            <TextView
                    android:id="@+id/ttsMiniPlayerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp"
                    tools:text="Chapter 1 – El comienzo" />
        </LinearLayout>

        <ImageButton
                android:id="@+id/ttsMiniPlayerBackward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tts_mini_player_backward"
                android:src="@drawable/ic_baseline_fast_rewind_24"
                app:tint="?attr/textColor" />

        <ImageButton
                android:id="@+id/ttsMiniPlayerPlayPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="10dp"
                android:background="@drawable/tts_mini_player_play_bg"
                android:contentDescription="@string/tts_mini_player_play_pause"
                android:src="@drawable/ic_baseline_pause_24"
                app:tint="?attr/white" />

        <ImageButton
                android:id="@+id/ttsMiniPlayerForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tts_mini_player_forward"
                android:src="@drawable/ic_baseline_fast_forward_24"
                app:tint="?attr/textColor" />

        <!-- Detener: más discreto que el resto para no pulsarlo sin querer -->
        <ImageButton
                android:id="@+id/ttsMiniPlayerClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tts_mini_player_stop"
                android:src="@drawable/ic_baseline_stop_24"
                app:tint="?attr/grayTextColor" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
