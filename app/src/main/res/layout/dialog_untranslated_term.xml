<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo al elegir un término sin traducir: campo para su traducción al español. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialog_untranslated_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/untranslated_dialog_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_untranslated_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/dialog_untranslated_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/untranslated_dialog_note"
        android:textColor="?attr/grayTextColor"
        android:textSize="12sp" />

    <!-- frase del capítulo con el término, para dar contexto al elegir la traducción -->
    <TextView
        android:id="@+id/dialog_untranslated_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="?attr/grayTextColor"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />
</LinearLayout>
